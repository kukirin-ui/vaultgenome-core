# Go build output
/bin/
/dist/
# `go build ./cmd/<name>` from the module root drops the binary here.
/sagvd
/acp-compute
/acp-bootstrap
/acp-demo
/acpctl
*.exe
*.test
*.out
*.prof
*.trace

# Coverage artifacts
coverage.out
coverage.html
coverage.txt

# SBOMs and attestations (generated by CI, never committed)
*.sbom.json
*.sbom.spdx.json
*.sig
*.cert
*.intoto.jsonl

# Local env and secrets (NEVER commit)
.env
.env.*
!.env.example
*.key
*.pem
# The synthetic root of the acpctl attest-nitro fixture is a test certificate, not a key.
!cmd/acpctl/testdata/nitro/synthetic-root.pem
!docs/**/*.pem.example
# public AMD KDS certificate chains captured as hardware attestation evidence
# (X.509 certs, not keys) — needed by the SEV-SNP verification tests.
!scripts/hardware-test/**/*.pem

# Key material provisioned by deploy/compose/keygen (NEVER commit)
/deploy/compose/secrets/

# Local vault state (operational artifacts, not source)
/var/
/data/
*.bolt
*.db
*.wal

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Go module cache symlinks (per-developer)
/vendor/

# Terraform / infra state (if/when added)
*.tfstate
*.tfstate.backup
.terraform/

# --- honest-reference build snapshot ignores ---
**/.terraform/
*.tfstate
*.tfstate.*
**/main.tf.bak

# Python worker caches
__pycache__/
.pytest_cache/

# Compose demo: sealed genomes with their key files, and the base model.
deploy/compose/genomes/
deploy/compose/models/
deploy/compose/audit/
